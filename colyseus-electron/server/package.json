{
  "private": true,
  "name": "my-server",
  "version": "0.1.0",
  "description": "A Colyseus multiplayer server",
  "type": "module",
  "main": "build/index.js",
  "engines": {
    "node": ">= 22.0.0"
  },
  "scripts": {
    "start": "tsx watch src/index.ts",
    "loadtest": "tsx loadtest/example.ts --room my_room --numClients 2",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "rimraf build",
    "test": "mocha -r tsx test/**.test.ts --exit --timeout 15000"
  },
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@colyseus/loadtest": "^0.18.0",
    "@colyseus/sdk": "^0.18.0",
    "@colyseus/testing": "^0.18.0",
    "@types/express": "^4.17.21",
    "@types/mocha": "^10.0.0",
    "mocha": "^10.0.0",
    "rimraf": "^5.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@colyseus/schema": "^5.0.8",
    "@colyseus/tools": "^0.18.0",
    "colyseus": "^0.18.0",
    "express": "^4.21.0"
  },
  "allowScripts": {
    "msgpackr-extract@3.0.4": true,
    "esbuild@0.28.2": true
  }
}
